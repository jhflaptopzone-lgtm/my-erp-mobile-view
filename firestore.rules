rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserWorkspace(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.erpAccessId is string && data.erpAccessId.size() >= 1 && data.erpAccessId.size() <= 64 &&
             data.serverUrl is string && data.serverUrl.size() >= 1 && data.serverUrl.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSyncEvent(data) {
      return data.action is string && data.action.size() >= 1 && data.action.size() <= 64 &&
             data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 64 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
             data.serverSynced is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'erpAccessId', 'serverUrl', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'erpAccessId', 'serverUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserWorkspace(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserWorkspace(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'erpAccessId', 'serverUrl', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /sync_events/{eventId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(eventId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(eventId) &&
                         incoming().keys().hasAll(['action', 'entityType', 'summary', 'serverSynced', 'createdAt']) &&
                         incoming().keys().hasOnly(['action', 'entityType', 'summary', 'serverSynced', 'createdAt']) &&
                         isValidSyncEvent(incoming());

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(eventId);
      }
    }
  }
}
