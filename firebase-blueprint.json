{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Mobile operator workspace profile and live web sync endpoint configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "erpAccessId": { "type": "string" },
        "serverUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "erpAccessId", "serverUrl", "createdAt", "updatedAt"]
    },
    "SyncEvent": {
      "title": "SyncEvent",
      "description": "Mobile-to-web ERP synchronization audit event",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "summary": { "type": "string" },
        "serverSynced": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "entityType", "summary", "serverSynced", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserWorkspace",
      "description": "Mobile workspace settings and linked ERP identity per authenticated Google user"
    },
    "/users/{userId}/sync_events/{eventId}": {
      "schema": "SyncEvent",
      "description": "Mobile sync audit events pushed to the live web backend"
    }
  }
}
